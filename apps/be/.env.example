# --- server ---
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# --- chain ---
# 143 = Monad mainnet, where the vault is deployed. 10143 = Monad testnet, which has no Kuru liquidity.
CHAIN_ID=143
# Optional override; defaults to the public RPC for CHAIN_ID
RPC_URL=

# --- DeltaMon contracts (leave empty until deployed; the API then serves demo data) ---
VAULT_ADDRESS=

# --- keeper (DeltaMonVault) ---
KEEPER_ENABLED=false
# The vault's keeper key. The admin must call setKeeper(<its address>) on the vault. It can mark
# the perp book inside the band and claim staking rewards, and nothing else.
# Without a key the keeper runs dry: it simulates every call and logs what it would send.
KEEPER_PRIVATE_KEY=
KEEPER_INTERVAL_MS=60000
# Published by whoever runs the short leg: {"equity":"<USDC units>","asOf":<unix seconds>}, the
# managers' total holdings, wallets plus Perpl equity. Without it the perp mark goes stale and the
# vault pauses deposits, which is the safe way to fail.
PERP_BOOK_URL=
# Existing external manager bot publishes equity and optional shortNotional in six-decimal USDC units,
# plus asOf in Unix seconds. A missing/stale shortNotional never counts as measured neutrality.
PERP_BOOK_MAX_AGE_SEC=300
PERP_MARK_MIN_CHANGE_BPS=25
# Validators the vault delegates to, comma separated, e.g. 5,12
VALIDATOR_IDS=
# The smallest reward claim worth a transaction, in MON
REWARDS_MIN_CLAIM_MON=1

# --- Perpl (hedge venue) ---
PERPL_API_URL=https://app.perpl.xyz/api
PERPL_CHAIN_ID=143

# Produced by `pnpm --filter @deltamon/be perpl:enroll`. Secrets: never commit, never expose to the FE.
# The token is shown once. The secret is generated locally and never sent to Perpl.
PERPL_API_KEY=
PERPL_API_KEY_SECRET=

# --- one-time enrolment inputs (only needed while running perpl:enroll) ---
# Optional. Leave empty to send no Origin header, which works from a server.
# A non-whitelisted Origin is rejected with 400, so only set this once Perpl has whitelisted it.
PERPL_ORIGIN=
# The vault address. It owns the Perpl account, so the key acts for this profile.
PERPL_TARGET_PROFILE=
# Admin wallet key, used once to sign the enrolment. Remove it again afterwards.
PERPL_ENROLL_PRIVATE_KEY=
# 2 = trade, which implies read. Withdrawals are impossible at any scope.
PERPL_SCOPE_MASK=2
PERPL_KEY_LABEL=deltamon-keeper
# Optional hardening: restrict the key to your backend's address, up to four ranges.
PERPL_IP_CIDRS=
