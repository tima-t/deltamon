{
  "name": "@deltamon/be",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "DeltaMon API + keeper: serves vault stats and rebalances the delta-neutral strategy",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "keeper": "tsx src/keeper.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@deltamon/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "pino": "^10.3.1",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@deltamon/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
